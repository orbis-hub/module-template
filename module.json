{
  "id": "my-module",
  "name": "My Module",
  "version": "0.1.0",
  "description": "What this module does, in one sentence.",
  "author": "your name",
  "repo": "github:your-user/orbis-module-my-module",
  "icon": "sparkles",
  "minHub": "0.2.0",
  "entry": { "server": "dist/server.js", "client": "dist/client.js" },
  "languages": ["en", "de"],
  "eink": true,
  "widgets": [
    {
      "id": "counter",
      "name": "Counter",
      "description": "A counter that lives on the hub and syncs to every client.",
      "defaultSize": { "w": 3, "h": 2 },
      "minSize": { "w": 2, "h": 1 },
      "configSchema": {
        "type": "object",
        "properties": {
          "label": { "type": "string", "title": "Label", "maxLength": 40 },
          "step": { "type": "integer", "title": "Step", "default": 1, "minimum": 1, "maximum": 100 }
        }
      }
    }
  ],
  "pages": [{ "id": "main", "name": "My Module", "icon": "sparkles" }],
  "settingsSchema": {
    "type": "object",
    "properties": {
      "greeting": { "type": "string", "title": "Greeting", "maxLength": 40 },
      "milestone": { "type": "integer", "title": "Notify every n clicks", "default": 100, "minimum": 10, "maximum": 100000 },
      "apiToken": { "type": "string", "title": "API token (example secret)", "format": "secret", "description": "only admins can read it back" }
    }
  },
  "permissions": ["storage", "settings:read", "notifications"]
}
