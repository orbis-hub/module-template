{
  "id": "my-module",
  "name": "My Module",
  "version": "0.1.0",
  "description": "What this module does, in one sentence.",
  "author": "your name",
  "repo": "github:your-user/orbis-module-my-module",
  "icon": "sparkles",
  "minHub": "0.1.0",
  "entry": { "server": "dist/server.js", "client": "dist/client.js" },
  "widgets": [
    {
      "id": "counter",
      "name": "Counter",
      "description": "A counter that lives on the hub and syncs to every client.",
      "defaultSize": { "w": 3, "h": 2 },
      "minSize": { "w": 2, "h": 1 },
      "configSchema": {
        "type": "object",
        "properties": {
          "label": { "type": "string", "title": "Label", "default": "clicks" },
          "step": { "type": "integer", "title": "Step", "default": 1, "minimum": 1 }
        }
      }
    }
  ],
  "pages": [{ "id": "main", "name": "My Module", "icon": "sparkles" }],
  "settingsSchema": {
    "type": "object",
    "properties": {
      "greeting": { "type": "string", "title": "Greeting", "default": "hello" }
    }
  },
  "permissions": ["storage"]
}
